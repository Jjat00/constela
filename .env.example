# Local (Supabase CLI — `pnpm exec supabase status` para ver los valores)
# Ojo: puertos movidos a 4432X en supabase/config.toml — Windows/WSL2 excluye el rango 54299-54398
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:44321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth (único login — ver docs/adr/0002). Crear en Google Cloud Console:
# credenciales OAuth "Aplicación web" con redirect http://127.0.0.1:44321/auth/v1/callback (local)
# y https://usaytsxnbqxyrmdpewbw.supabase.co/auth/v1/callback (prod).
# El Supabase CLI las lee del entorno: arrancar con scripts/supabase-start.sh
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Producción (proyecto `constela` en supabase.com — ref: usaytsxnbqxyrmdpewbw)
# NEXT_PUBLIC_SUPABASE_URL=https://usaytsxnbqxyrmdpewbw.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key del dashboard>
